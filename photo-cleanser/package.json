{
  "name": "photo-cleanser-web",
  "version": "1.0.0",
  "private": true,
  "description": "Sito statico che oscura volti, loghi e sfondo delle foto direttamente nel browser",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build-site.mjs",
    "test:unit": "node --test \"tests/js/*.test.mjs\"",
    "test:e2e": "node tests/e2e/run.mjs",
    "test": "npm run test:unit && npm run build && npm run test:e2e",
    "serve": "node scripts/serve.mjs"
  },
  "dependencies": {
    "@litertjs/core": "2.6.0",
    "onnxruntime-web": "1.31.1"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "playwright-core": "1.65.1"
  }
}
